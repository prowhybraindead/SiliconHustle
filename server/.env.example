# Core API Configuration
APP_NAME="Silicon Hustle API"
ENVIRONMENT=local
DATABASE_URL=sqlite:///./silicon_hustle.db
FRONTEND_ORIGIN=http://localhost:5173

# Production Deployment Configuration Presets (Reference)
# ENVIRONMENT=production
# DATABASE_URL=sqlite:////var/lib/silicon_hustle/silicon_hustle.db
# FRONTEND_ORIGIN=https://your-cloudflare-pages-domain.pages.dev

# NestyAI / AI Service Config (Safe mock values)
NESTYAI_BASE_URL=https://ai.example.com
NESTYAI_API_KEY=nsk_mock_placeholder_key_value
NESTYAI_MODEL_DEFAULT=nestyai-default

# Foreign Exchange (FX) Desk Config
BASE_CURRENCY=VND
FX_ENABLED=true
FX_EXTERNAL_CALLS_ENABLED=true
FX_PRIMARY_PROVIDER=frankfurter
FX_FALLBACK_PROVIDER=exchangerate_api_open_access
FX_CACHE_TTL_SECONDS=21600
FX_REQUEST_TIMEOUT_SECONDS=8
FX_STATIC_FALLBACK_ENABLED=true
FX_SPREAD_PERCENT_DEFAULT=1.5

# LiveOps & AI Market Events Settings
AI_MARKET_EVENTS_ENABLED=false
AI_MARKET_EVENTS_MODEL=nesty-flash-1.0
AI_MARKET_EVENTS_MAX_ACTIVE_CONTEXT=5
MARKET_RANDOM_EVENT_CHANCE=0.20
MARKET_MAX_ACTIVE_EVENTS=5
MARKET_MIN_MULTIPLIER=0.35
MARKET_MAX_MULTIPLIER=3.5

# Player Profile Access Security Settings
PROFILE_PIN_ENABLED=true
PROFILE_UNLOCK_TTL_HOURS=168
PROFILE_PIN_MIN_LENGTH=4
PROFILE_PIN_MAX_LENGTH=12
