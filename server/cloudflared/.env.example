# Cloudflare Tunnel token from Cloudflare Zero Trust dashboard.
# Do NOT commit a real .env file.
CLOUDFLARED_TOKEN=replace-with-your-cloudflare-tunnel-token

# Optional: override cloudflared binary path.
CLOUDFLARED_BIN=cloudflared

# Optional: auto-install cloudflared into a local .bin folder if missing.
CLOUDFLARED_AUTO_INSTALL=1

# Optional: extra args for cloudflared tunnel run.
CLOUDFLARED_EXTRA_ARGS=
